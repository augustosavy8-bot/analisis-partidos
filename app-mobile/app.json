{
  "expo": {
    "name": "Point",
    "slug": "point",
    "scheme": "point",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.point.fidelizacion",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:fidelizacion-beta.vercel.app"
      ]
    },
    "android": {
      "package": "com.point.fidelizacion",
      "adaptiveIcon": {
        "backgroundColor": "#111311",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#111311"
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Point usa NFC para grabar los llaveros de los locales.",
          "selectIdentifiers": [
            "D2760000850101",
            "D2760000850100"
          ],
          "includeNdefEntitlement": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://fidelizacion-beta.vercel.app",
      "eas": {
        "projectId": "234af9c9-107c-46af-95a9-52167e817de0"
      }
    },
    "owner": "point-team"
  }
}
