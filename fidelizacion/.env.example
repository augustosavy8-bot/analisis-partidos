# --- Supabase ---------------------------------------------------------------
# Local (npx supabase start) imprime estos valores. En la nube: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: nunca con prefijo NEXT_PUBLIC_. Sólo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000

# Modo prueba de chips (tags NTAG213 con token estático).
# true en desarrollo; en producción poné false para rechazar chips en modo prueba.
PERMITIR_MODO_PRUEBA=true

# --- Próximas fases (todavía no se usan) -------------------------------------
# Secreto HMAC para el QR de respaldo (fase 2). Generar: openssl rand -base64 32
QR_HMAC_SECRET=
# Clave maestra AES-256 (hex, 64 caracteres) para cifrar las claves de los chips (fase 3).
# Generar: openssl rand -hex 32
CHIPS_MASTER_KEY=
