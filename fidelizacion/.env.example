# --- Supabase ---------------------------------------------------------------
# Local (npx supabase start) imprime estos valores. En la nube: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: nunca con prefijo NEXT_PUBLIC_. Sólo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000

# Modo prueba de chips (tags NTAG213 con token estático).
# true en desarrollo; en producción poné false para rechazar chips en modo prueba.
PERMITIR_MODO_PRUEBA=true

# Secreto para firmar tokens (toque pendiente y QR de respaldo). Mínimo 32 caracteres.
# Generar: openssl rand -base64 32
HMAC_SECRET=

# Clave AES-128 SDMMetaRead común a todos los chips NTAG 424 DNA (32 hex).
# Se graba en cada chip como la clave que cifra el PICCData. Generar: openssl rand -hex 16
NFC_SDM_META_KEY=

# Clave maestra AES-256 (hex, 64 caracteres) para cifrar las claves de los chips.
# Generar: openssl rand -hex 32
CHIPS_MASTER_KEY=
