# --- Supabase ---------------------------------------------------------------
# Local (npx supabase start) imprime estos valores. En la nube: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: nunca con prefijo NEXT_PUBLIC_. Sólo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000

# Modo prueba de chips (tags NTAG213 con token estático).
# true en desarrollo; en producción poné false para rechazar chips en modo prueba.
PERMITIR_MODO_PRUEBA=true

# Secreto para firmar tokens (toque pendiente y QR de respaldo). Mínimo 32 caracteres.
# Generar: openssl rand -base64 32
HMAC_SECRET=

# Clave AES-128 SDMMetaRead común a todos los chips NTAG 424 DNA (32 hex).
# Se graba en cada chip como la clave que cifra el PICCData. Generar: openssl rand -hex 16
NFC_SDM_META_KEY=

# Clave maestra AES-256 (hex, 64 caracteres) para cifrar las claves de los chips.
# Generar: openssl rand -hex 32
CHIPS_MASTER_KEY=

# --- Google Wallet (opcional) --------------------------------------------------
# Si faltan, el botón "Agregar a Google Wallet" no aparece y se usa Pass2U.
# Issuer ID: Google Pay & Wallet Console → Google Wallet API (sólo dígitos).
GOOGLE_WALLET_ISSUER_ID=
# Contenido COMPLETO del JSON de la cuenta de servicio (en una línea), con acceso
# de "Developer" al issuer. Google Cloud → IAM → Cuentas de servicio → Claves.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Apple Wallet (opcional) ---------------------------------------------------
# Si falta alguna, el botón "Agregar a Apple Wallet" no aparece.
# Pass Type ID (Certificates, Identifiers & Profiles → Identifiers → Pass Type IDs).
APPLE_PASS_TYPE_ID=pass.com.point.fidelizacion
# Team ID de la cuenta de Apple Developer (10 caracteres).
APPLE_TEAM_ID=
# PEM del certificado del Pass Type ID, de su clave privada (sin contraseña) y del
# certificado intermedio Apple WWDR G4. Pegalos completos (con BEGIN/END); los "\n"
# literales se convierten solos en saltos de línea.
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_WWDR_CERT=

# --- Mercado Pago (facturación de Point) --------------------------------------
# Credenciales de la aplicación "Point" en Mercado Pago → Tus integraciones.
# En pruebas: las credenciales de la cuenta de prueba VENDEDOR (ver TESTING.md).
# Access Token: sólo servidor, nunca al navegador.
MP_ACCESS_TOKEN=
# Public Key: la usa el formulario de tarjeta (Card Payment Brick) en el navegador.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Clave secreta de Webhooks (Tus integraciones → Webhooks → Configurar notificación).
MP_WEBHOOK_SECRET=
# Protege /api/cron/* (Vercel Cron la manda como "Authorization: Bearer ...").
CRON_SECRET=
